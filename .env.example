# i Store | ئایستۆر — environment template
# Copy to .env and fill real values. NEVER commit .env.

APP_ENV=development
SESSION_SECRET=change-me-to-a-long-random-string
# Fernet key for encrypting secrets at rest (see services/secrets.py).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DB_ENCRYPTION_KEY=
DATABASE_URL=sqlite:////home/hatch/workspace/istore/istore.db
# Production example:
# DATABASE_URL=postgresql+psycopg2://istore:STRONGPASS@localhost:5432/istore

# Provider (KD1S) — server-side only
PROVIDER_MODE=mock
KD1S_API_URL=https://kd1s.com/api/v2
KD1S_API_KEY=

# Telegram bot (from @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=

# Currency
DEFAULT_CURRENCY=USD
USD_TO_IQD=1500

# Workers
SYNC_INTERVAL_MINUTES=60
ORDER_POLL_INTERVAL_MINUTES=5
